{
  "name": "careeros",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 4000 --app-dir backend/src",
    "install:backend": "python -m pip install -r backend/requirements.txt",
    "check:backend": "python -m compileall backend/src",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
