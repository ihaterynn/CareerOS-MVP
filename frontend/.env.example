# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Browser-safe (NEXT_PUBLIC_* is inlined into the client bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# ---------------------------------------------------------------------------
# Server-only. Anything below must NEVER be prefixed NEXT_PUBLIC_ and must never
# be imported from a client component.
# ---------------------------------------------------------------------------

# RLS-bypassing. Used only where a policy cannot express the need (public DNA
# share-token lookup, backend jobs, seed scripts) — never for candidate reads.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Résumé Studio's fixed demo candidate. Onboarding does NOT use this: it resolves
# the candidate from the session via current_candidate_id().
DEMO_CANDIDATE_ID=

# Shared by Résumé Studio and onboarding. For onboarding it is optional: without
# it, parse and DNA fall back to a clearly-labelled demo path instead of failing.
OPENROUTER_API_KEY=

# Pinned per release so a provider-side model change can't silently alter output.
# Defaults to anthropic/claude-sonnet-4.5 when unset.
ONBOARDING_LLM_MODEL=
